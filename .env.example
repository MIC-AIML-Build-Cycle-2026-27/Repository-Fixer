# Copy this file to .env and fill in real values locally.
# .env is ignored by git. Never commit real credentials.

ENVIRONMENT=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://repofixer:repofixer@localhost:5432/repofixer

# Valkey (Redis-compatible queue/cache)
VALKEY_URL=valkey://localhost:6379/0

# GitHub
GITHUB_TOKEN=replace-me
GITHUB_WEBHOOK_SECRET=replace-me

# LLM: for the LLM team's client. Not used yet; the worker uses FakeLLMClient until it lands.
LLM_API_KEY=replace-me
